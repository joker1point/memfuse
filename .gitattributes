# Line-ending strategy (do not rely on each machine's core.autocrlf)
* text=auto

# PowerShell scripts: LF in the repo, CRLF in the working tree (target platform: Windows)
*.ps1 text eol=crlf

# Batch launchers: the release zip is built with "git archive", so these need an
# explicit eol rule too - bare LF in a .cmd breaks label jumps (E-20). Under
# "* text=auto" alone they come out of the archive as pure LF: verified on
# v1.3.0 (all three launchers, bareLF=32/28/18) before this rule existed.
*.cmd text eol=crlf
*.bat text eol=crlf

# Docs: LF everywhere
*.md text eol=lf
*.txt text eol=lf
